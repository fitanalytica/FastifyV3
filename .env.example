PORT=3003
JWE_SECRET=change-me
JWT_EXPIRY=7d
# How long the previous refresh value still works after a rotation (a lost reply must not sign the user out). Unset = 30 days, for production.
# Local testing of the sign-in: REFRESH_GRACE_SECONDS=120
PG_WRITER_URL=postgres://api_writer:dev@localhost:5432/fitanalytica_dev
PG_READER_URL=postgres://api_reader:dev@localhost:5432/fitanalytica_dev
PG_SSL=false
DEV_LOGIN=false   # true only on a local machine: enables POST /v3/auth/dev-login
# Local testing only: which local user dev-login signs in as for provider apple / google (a userid already in the local database)
# DEV_USER_APPLE=
# DEV_USER_GOOGLE=
# Media in S3 (docs/data/server.md section 6). In production set only the region: the credentials come from the server's role.
S3_REGION=us-east-1
# S3_BUCKET_MEDIA=activitees
# S3_BUCKET_PROFILE=fitpy
# Local testing only: MinIO (docs/data/dev-s3/README.md)
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# Weather providers (docs/data/api.md section 13): WeatherAPI first, OpenWeather as the fallback. Without both the weather route answers 503.
# WEATHER_API=
# OPEN_WEATHER_API=

# Sign in with Apple and Google (docs/data/api.md section 1b). Without the Google ids, Google sign-in answers 503.
# GOOGLE_CLIENT_IDS=<ios-client-id>.apps.googleusercontent.com   (comma-separated: the iOS client, and the web client if the app uses one)
# APPLE_CLIENT_ID=com.fitanalytica
# Needed to keep Apple's refresh token and to revoke it when an account is deleted (the Key from the Apple developer account):
# APPLE_TEAM_ID=
# APPLE_KEY_ID=   (or APPLE_SIGNIN_KEYID)
# APPLE_PRIVATE_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8   (or APPLE_SIGNIN_PRIVATE_KEY_BASE64=<the same file, base64>)
# It must be the key made for Sign in with Apple (Certificates, Identifiers & Profiles > Keys), NOT the In-App Purchase / subscription key: Apple refuses that one.
# LOGIN_RATE_LIMIT=20   (sign-in tries per address per minute)

# E-mail for the account-deletion code (docs/data/api.md section 8b): the SNS topic the old API publishes mail to, and its region. Credentials: the server's role,
# or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY locally. With no SNS_ARN and DEV_LOGIN=true the code is only written to the server's log.
# SNS_ARN=arn:aws:sns:us-east-1:<account>:<topic>
# SNS_REGION=us-east-1

# Which billing tables the Pro state reads (docs/data/api.md section 15): production (the default), sandbox, or both (also serves TestFlight and App Review).
# BILLING_ENV=production

# Apple purchases (docs/data/api.md section 15): the numeric App Store id of the app. Needed to check PRODUCTION purchases and notifications (sandbox ones need only APPLE_CLIENT_ID,
# the bundle id). Without it a production purchase answers 503.
# APPLE_APP_ID=1234567890

# Sign in with Apple on ANDROID goes through Apple's web page, with a Services ID (not the bundle id): its tokens are for this audience, and the code exchange and the revoke use it. Default shown.
# APPLE_SERVICES_ID=com.fitanalytica.weblogin.sid

# Google Play purchases (docs/data/api.md section 15). The server asks the Play Developer API with a service account: GOOGLE_APPLICATION_CREDENTIALS is the path of its key file (or the host's workload
# identity). PLAY_NOTIFY_* are what the Pub/Sub push subscription of the real-time developer notifications was made with (its audience and its service account): the notification route accepts only that.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/play-service-account.json
# PLAY_PACKAGE_NAME=com.fitanalytica
# PLAY_NOTIFY_AUDIENCE=https://store.example.com/store/v3/playstore
# PLAY_NOTIFY_SERVICE_ACCOUNT=pubsub-push@your-project.iam.gserviceaccount.com

# IP lookup for users with location off (docs/data/server.md section 7). The local database first (MaxMind GeoLite2-City, an .mmdb file kept outside git, refreshed
# regularly: the licence asks for it), the MaxMind web service when the file cannot answer. Without either the place stays unknown (never an error for the user).
# GEOIP_DB_PATH=/path/to/GeoLite2-City.mmdb
# MAXMIND_ACCOUNT_ID=
# MAXMIND_LICENSE_KEY=
# The key that signs the `ipref` (a keyed hash of the IP address, so the address itself is never stored). Unset: derived from JWE_SECRET.
# IPREF_KEY=
# Behind a load balancer set this so the client's address is read from X-Forwarded-For: true, or the number of proxies (docs/data/production-checklist.md). Unset: the socket's address.
# TRUST_PROXY=true
