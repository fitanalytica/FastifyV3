PORT=3003
JWE_SECRET=change-me
JWT_EXPIRY=7d
# How long the previous refresh value still works after a rotation (a lost reply must not sign the user out). Unset = 30 days, for production.
# Local testing of the sign-in: REFRESH_GRACE_SECONDS=120
PG_WRITER_URL=postgres://api_writer:dev@localhost:5432/fitanalytica_dev
PG_READER_URL=postgres://api_reader:dev@localhost:5432/fitanalytica_dev
PG_SSL=false
DEV_LOGIN=false   # true only on a local machine: enables POST /v3/auth/dev-login
# Local testing only: which local user dev-login signs in as for provider apple / google (a userid already in the local database)
# DEV_USER_APPLE=
# DEV_USER_GOOGLE=
# Media in S3 (docs/data/server.md section 6). In production set only the region: the credentials come from the server's role.
S3_REGION=us-east-1
# S3_BUCKET_MEDIA=activitees
# S3_BUCKET_PROFILE=fitpy
# Local testing only: MinIO (docs/data/dev-s3/README.md)
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# Weather providers (docs/data/api.md section 13): WeatherAPI first, OpenWeather as the fallback. Without both the weather route answers 503.
# WEATHER_API=
# OPEN_WEATHER_API=
