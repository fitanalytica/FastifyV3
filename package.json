{
  "name": "fastify-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.local -- tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "dotenv -e .env.test -- vitest run",
    "backfill:preview": "dotenv -e .env.local -- tsx scripts/backfill-route-preview.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/client-sns": "^3.1170.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/postgres": "^6.1.2",
    "@fastify/rate-limit": "^11.2.2",
    "@maxmind/geoip2-node": "^7.1.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "google-auth-library": "^10.9.1",
    "jose": "^6.2.17",
    "lru-cache": "^11.5.3",
    "maxmind": "^5.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^11.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
